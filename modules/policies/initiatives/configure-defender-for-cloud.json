{
  "properties": {
    "displayName": "Configure Microsoft Defender for Cloud",
    "policyType": "Custom",
    "description": "Configure Microsoft Defender for Cloud.",
    "metadata": {
      "version": "1.0.0",
      "category": "Security Center"
    },
    "parameters": {
      "emailSecurityContact": {
        "type": "string",
